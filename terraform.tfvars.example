# Loaded automatically by terraform plan/apply.
# Find your current IP with: curl https://checkip.amazonaws.com

# Who can reach the EKS API from the internet (kubectl, terraform)
api_allowed_cidrs = [
  "203.0.113.10/32",
]

# Regular EKS with a managed node group instead of Auto Mode
eks_auto_mode = false

# Nodes in public subnets with public IPs; no NAT gateways or VPC endpoints
public_subnets_only = true

# Managed node group (only used when eks_auto_mode = false)
node_instance_types = ["t3.small"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 1
node_desired_size   = 1

# Nitro Sandbox node group (m6g.large, arm64). Build the AMI with
# ami/build-sandbox-ami.sh, then paste its ID here. Empty = no sandbox nodes.
sandbox_ami_id = ""
